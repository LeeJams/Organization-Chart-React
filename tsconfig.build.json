{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["react", "react-dom"]
  },
  "include": [
    "src/index.ts",
    "src/index.cts",
    "src/stylesheet.ts",
    "src/types.ts",
    "src/style.d.ts",
    "src/OrganizationChart.tsx",
    "src/OrganizationChartNode.tsx",
    "src/utils/**/*.ts"
  ],
  "exclude": ["src/App.tsx", "src/main.tsx", "tests"]
}
